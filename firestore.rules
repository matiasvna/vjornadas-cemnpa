rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inscripciones/{document} {
      // Permite registrar la confirmación/inscripción de bloque
      allow create: if request.resource.data.nombreApellido is string
                    || request.resource.data.nombre is string;
      
      // Permite lectura, actualización y cancelación (delete) de confirmaciones
      allow read, delete, update: if true;
    }
  }
}
